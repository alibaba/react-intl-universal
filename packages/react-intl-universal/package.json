{
  "name": "react-intl-universal",
  "version": "2.14.0-beta.2",
  "description": "Internationalize React apps. Not only for React component but also for Vanilla JS.",
  "keywords": [
    "intl",
    "i18n",
    "internationalization",
    "locale",
    "localization",
    "globalization",
    "react",
    "format",
    "translate",
    "plural",
    "icu"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./es/index.js",
      "require": "./lib/index.js"
    }
  },
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch --verbose --coverage",
    "test:types": "tsc -p tsconfig.test-types.json --noEmit",
    "clean": "rimraf coverage/ lib/ es/",
    "build": "npm run clean && rollup -c rollup.config.mjs && tsc -p tsconfig.build.json && node ./scripts/write-es-package-json.js && cp ../../README.md ./",
    "preversion": "npm run test && npm run build && npm run test:types",
    "prepublish": "npm run build"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "escape-html": "^1.0.3",
    "intl-messageformat": "^11.2.8",
    "invariant": "^2.2.4",
    "lodash.merge": "^4.6.2"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/escape-html": "^1.0.4",
    "@types/invariant": "^2.2.37",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "^19.2.17",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.2.7",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "jest": {
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "testRegex": "/test/.*\\.test.js",
    "testPathIgnorePatterns": [],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(intl-messageformat|@formatjs/fast-memoize|@formatjs/icu-messageformat-parser|@formatjs/icu-skeleton-parser)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageReporters": [
      "lcov",
      "text",
      "text-summary",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "verbose": true
  },
  "homepage": "https://github.com/alibaba/react-intl-universal",
  "repository": {
    "type": "git",
    "url": "https://github.com/alibaba/react-intl-universal.git"
  },
  "types": "./lib/index.d.ts"
}
